{
  "name": "academia",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/admin",
      "/admin/",
      "/admin.html",
      "/admin-panel.asset",
      "/api/*",
      "/media/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "academia-velarian-db",
      "database_id": "5750bd0a-fd2f-4345-80b2-c5abfd9d470a"
    }
  ]
}
